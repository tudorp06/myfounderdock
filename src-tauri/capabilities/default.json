{
  "identifier": "main-window",
  "description": "Local dock with permission to open GitHub links in the default browser. No filesystem or credential access.",
  "windows": [
    "main",
    "settings"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/*"
        }
      ]
    },
    "core:window:allow-start-dragging"
  ]
}
